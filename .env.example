# APP_URL: URL ที่ tunnel ชี้มา (Cloudflare / ngrok) — ใช้กำหนด allowedDevOrigins ใน next.config.ts
# เปลี่ยนโดเมน tunnel แล้วอัปเดตค่านี้ + restart dev server
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# App mode — rebuild หลังเปลี่ยน NEXT_PUBLIC_APP_MODE
# -----------------------------------------------------------------------------
# developer: localStorage + mock (ทำงานบนเครื่อง dev)
# product:   API → D1 + R2 (ใช้ตอน deploy production)
APP_MODE=developer
NEXT_PUBLIC_APP_MODE=developer

# เปิดข้อมูล demo/mock (developer mode เท่านั้น)
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# Production / deploy (ตั้งใน Cloudflare Dashboard, wrangler.toml [vars], หรือ CI)
# ดูคู่มือ: docs/DEPLOY_CLOUDFLARE.md
# -----------------------------------------------------------------------------
# APP_MODE=product
# NEXT_PUBLIC_APP_MODE=product
# NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Backend สำหรับ /api/site — memory = ทดสอบใน RAM, d1 = Cloudflare D1 (binding DB)
# SITE_STORE=d1

# Single-tenant site id — ตรงกับ schema.sql sites.id
# SITE_ID=default

# R2 — ชื่อ bucket + URL สาธารณะสำหรับรูป (custom domain หรือ r2.dev)
# R2_BUCKET_NAME=architecture-tmv-media
# R2_PUBLIC_URL=https://media.example.com

# Wrangler bindings (ไม่ใส่ใน .env.local — กำหนดใน wrangler.toml):
#   [[d1_databases]] binding = "DB"
#   [[r2_buckets]]   binding = "MEDIA"
